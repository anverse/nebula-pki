# Multi-cert scenario: two certs with different groups, signed under a CA
# with group and network constraints. Verifies cert files, manifest cert
# records, and full idempotency on a second run.

exec nebula-pki
stderr '^generated CA "test-mesh" \(test-mesh\)$'
stderr '^signed cert "lighthouse"$'
stderr '^  cert: out/certs/lighthouse\.crt$'
stderr '^  key:  out/certs/lighthouse\.key$'
stderr '^signed cert "server"$'
stderr '^  cert: out/certs/server\.crt$'
stderr '^  key:  out/certs/server\.key$'
stderr '^wrote manifest: out/nebula-pki\.json$'
! stdout .

# All artifacts exist.
exists out/ca/test-mesh.crt
exists out/ca/test-mesh.key
exists out/certs/lighthouse.crt
exists out/certs/lighthouse.key
exists out/certs/server.crt
exists out/certs/server.key
exists out/nebula-pki.json

# PEM material is present in each file.
grep 'NEBULA CERTIFICATE' out/certs/lighthouse.crt
grep 'NEBULA X25519 PRIVATE KEY' out/certs/lighthouse.key
grep 'NEBULA CERTIFICATE' out/certs/server.crt
grep 'NEBULA X25519 PRIVATE KEY' out/certs/server.key

# Cert keys must be X25519 encryption keys, not Ed25519 signing keys —
# nebula rejects the latter when loading pki.key.
! grep 'NEBULA ED25519 PRIVATE KEY' out/certs/lighthouse.key

# Manifest records both certs under the top-level `certs` map with CA fingerprint.
grep '^  "certs": \{' out/nebula-pki.json
! grep '"hosts"' out/nebula-pki.json
grep '"lighthouse"' out/nebula-pki.json
grep '"server"' out/nebula-pki.json
grep '"ca_fingerprint"' out/nebula-pki.json

# Snapshot all artifacts.
cp out/ca/test-mesh.crt ca.crt.first
cp out/ca/test-mesh.key ca.key.first
cp out/certs/lighthouse.crt lighthouse.crt.first
cp out/certs/lighthouse.key lighthouse.key.first
cp out/certs/server.crt server.crt.first
cp out/certs/server.key server.key.first
cp out/nebula-pki.json manifest.first

# Second run: everything up to date, nothing written.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'signed cert'
! stdout .

# Byte-identical.
cmp out/ca/test-mesh.crt ca.crt.first
cmp out/ca/test-mesh.key ca.key.first
cmp out/certs/lighthouse.crt lighthouse.crt.first
cmp out/certs/lighthouse.key lighthouse.key.first
cmp out/certs/server.crt server.crt.first
cmp out/certs/server.key server.key.first
cmp out/nebula-pki.json manifest.first

-- nebula.hcl --
ca "test-mesh" {
  name     = "test-mesh"
  groups   = ["lighthouse", "app"]
  networks = ["10.0.0.0/16"]
}

cert "lighthouse" {
  networks = ["10.0.0.1/16"]
  groups   = ["lighthouse"]
}

cert "server" {
  networks = ["10.0.0.2/16"]
  groups   = ["app"]
}
