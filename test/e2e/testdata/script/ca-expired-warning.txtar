# Every declared CA counts in the deadline report. An expired CA prints a
# warning and is not a deadline, so it never hides the next real action
# (ADR-017 2026-10-02 amendment).

cp v1.hcl nebula.hcl
exec nebula-pki
stderr '^generated CA "old" \(mesh-old\)$'
! stderr 'expired'

exec sleep 3

exec nebula-pki
stderr '^up to date; nothing to do$'
stderr '^warning: CA "old" expired 0d ago \([0-9]{4}-[0-9]{2}-[0-9]{2}\)$'
stderr '^next deadline: '
! stderr 'next deadline: CA "old"'
! stderr 'overdue'
stderr '^hint: run nebula-pki again before '

# Dry run reports the same.
exec nebula-pki --dry-run
stderr '^warning: CA "old" expired 0d ago'

# The warning is printed even when the config has no certs.
cp v2.hcl nebula.hcl
exec nebula-pki
stderr '^warning: CA "old" expired 0d ago'

-- v1.hcl --
ca "old" {
  name     = "mesh-old"
  duration = "2s"
}

ca "new" {
  name    = "mesh-new"
  default = true
}

cert "app" {
  networks = ["10.0.0.1/16"]
}

-- v2.hcl --
ca "old" {
  name     = "mesh-old"
  duration = "2s"
}
