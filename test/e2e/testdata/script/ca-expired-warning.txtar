# Every declared CA counts in the deadline report. An expired CA prints a
# warning and is not a deadline, so it never hides the next real action
# (ADR-017 2026-10-02 amendment). The deadline report is the only place that
# warns, so an expired reference-mode CA is warned about once.

cp v1.hcl nebula.hcl
exec nebula-pki
stderr '^generated CA "old" \(mesh-old\)$'
! stderr 'expired'

exec sleep 3

exec nebula-pki
stderr '^up to date; nothing to do$'
stderr '^warning: CA "old" expired today \([0-9]{4}-[0-9]{2}-[0-9]{2}\)$'
stderr '^next deadline: '
! stderr 'next deadline: CA "old"'
! stderr 'overdue'
stderr '^hint: run nebula-pki again before '

# Dry run reports the same.
exec nebula-pki --dry-run
stderr '^warning: CA "old" expired today'

# The warning is printed even when the config has no certs.
cp v2.hcl nebula.hcl
exec nebula-pki
stderr '^warning: CA "old" expired today'

# An expired reference-mode CA is recorded and warned about once.
mkdir gen
cp gen.hcl gen/nebula.hcl
exec nebula-pki -c gen/nebula.hcl
exec sleep 3
cp ref.hcl nebula.hcl
exec nebula-pki
stderr '^using referenced CA "ref" \(mesh-ref\)$'
stderr '^warning: CA "ref" expired today'
! stderr 'recording it anyway'
! stderr 'referenced CA "ref" is expired'

-- v1.hcl --
ca "old" {
  name     = "mesh-old"
  duration = "2s"
}

ca "new" {
  name    = "mesh-new"
  default = true
}

cert "app" {
  networks = ["10.0.0.1/16"]
}

-- v2.hcl --
ca "old" {
  name     = "mesh-old"
  duration = "2s"
}

-- gen.hcl --
ca "ref" {
  name     = "mesh-ref"
  duration = "2s"
}

-- ref.hcl --
ca "ref" {
  cert_file = "gen/out/ca/ref.crt"
  key_file  = "gen/out/ca/ref.key"
}
