# A declared trust_bundle "main" writes out/bundles/main.crt, named after its
# label. With a single member the bundle equals that CA's certificate, it is
# byte-stable on re-runs, and the manifest records it under trust_bundles,
# keyed by label (ADR-026).

exec nebula-pki
stderr '^generated CA "mesh" \(mesh\)$'
stderr '^wrote trust bundle "main": out/bundles/main\.crt$'
stderr '^wrote manifest: out/nebula-pki\.json$'
! stdout .

exists out/ca/mesh.crt
exists out/ca/mesh.key
exists out/bundles/main.crt

# Single-member bundle must be byte-for-byte equal to the CA cert itself.
cmp out/bundles/main.crt out/ca/mesh.crt

# Manifest records the bundle under its label.
grep '"trust_bundles"' out/nebula-pki.json
grep '"main": \{' out/nebula-pki.json
grep '"path": "out/bundles/main.crt"' out/nebula-pki.json
grep '"ca_fingerprints"' out/nebula-pki.json
! grep '"links"' out/nebula-pki.json

cp out/ca/mesh.crt ca.crt.first
cp out/ca/mesh.key ca.key.first
cp out/bundles/main.crt bundle.crt.first
cp out/nebula-pki.json manifest.first

# Dry run on an up-to-date tree previews nothing.
exec nebula-pki --dry-run
stdout '^up to date; nothing to do$'
! stdout 'bundle'

# Second run: everything up to date, nothing rewritten.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'generated CA'
! stderr 'wrote trust bundle'
! stdout .

cmp out/ca/mesh.crt ca.crt.first
cmp out/ca/mesh.key ca.key.first
cmp out/bundles/main.crt bundle.crt.first
cmp out/nebula-pki.json manifest.first

# A deleted bundle file is rewritten on the next run.
rm out/bundles/main.crt
exec nebula-pki --dry-run
stdout '^\+ write out/bundles/main\.crt$'
exec nebula-pki
stderr '^wrote trust bundle "main": out/bundles/main\.crt$'
cmp out/bundles/main.crt bundle.crt.first

-- nebula.hcl --
trust_bundle "main" {
  ca_refs = [ca.mesh]
}

ca "mesh" {
  name = "mesh"
}
