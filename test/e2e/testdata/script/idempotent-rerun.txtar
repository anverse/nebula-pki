# Reconciling an unchanged tree a second time must write nothing — not even
# the manifest — so the committed output stays byte-identical across runs.

# First run: CA and cert are created.
exec nebula-pki
stderr '^generated CA "test-mesh" \(test-mesh\)$'
stderr '^signed cert "alpha"$'
! stdout .

# Snapshot every artifact.
cp out/ca/test-mesh.crt ca.crt.first
cp out/ca/test-mesh.key ca.key.first
cp out/certs/alpha.crt alpha.crt.first
cp out/certs/alpha.key alpha.key.first
cp out/nebula-pki.json manifest.first

# Second run must report "up to date" and touch nothing.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'generated CA'
! stderr 'signed cert'
! stdout .

# All artifacts are byte-identical to the first run.
cmp out/ca/test-mesh.crt ca.crt.first
cmp out/ca/test-mesh.key ca.key.first
cmp out/certs/alpha.crt alpha.crt.first
cmp out/certs/alpha.key alpha.key.first
cmp out/nebula-pki.json manifest.first

-- nebula.hcl --
ca "test-mesh" {
  name = "test-mesh"
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}
