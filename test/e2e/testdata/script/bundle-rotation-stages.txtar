# Full CA rotation with an explicit trust_bundle (ADR-026 "The rotation dance,
# revised").
#
# Step 1: steady state, a single "current" CA in a declared trust_bundle.
# Step 2: add "next" and list it in ca_refs, so the bundle carries both; certs unchanged.
# Step 3: promote "next" to default, so certs re-sign; bundle unchanged.
# Step 4: drop "current" from ca_refs, so the bundle shrinks to "next"; certs unchanged.
# Step 5: delete the "current" block; its files stay on disk with a notice.

# ── Step 1: initial state ─────────────────────────────────────────────────────
cp step1.hcl nebula.hcl
exec nebula-pki
stderr '^generated CA "current" \(test-mesh\)$'
stderr '^  cert: out/ca/current\.crt$'
stderr '^  key:  out/ca/current\.key$'
stderr '^signed cert "alpha"$'
stderr '^  cert: out/certs/alpha\.crt$'
stderr '^  key:  out/certs/alpha\.key$'
stderr '^signed cert "beta"$'
stderr '^  cert: out/certs/beta\.crt$'
stderr '^  key:  out/certs/beta\.key$'
stderr '^wrote trust bundle "main": out/bundles/main\.crt$'
stderr '^wrote manifest: out/nebula-pki\.json$'
! stdout .

exists out/ca/current.crt
exists out/ca/current.key
exists out/certs/alpha.crt
exists out/certs/beta.crt
exists out/bundles/main.crt

# Single-CA bundle equals the CA cert itself.
cmp out/bundles/main.crt out/ca/current.crt

# Manifest records "current" CA and both certs.
grep '"current"' out/nebula-pki.json
grep '"alpha"' out/nebula-pki.json
grep '"beta"' out/nebula-pki.json

# Snapshot certs and bundle for later comparison.
cp out/certs/alpha.crt alpha.step1.crt
cp out/certs/beta.crt  beta.step1.crt
cp out/bundles/main.crt   bundle.step1.crt

# ── Step 2: add "next" CA ─────────────────────────────────────────────────────
cp step2.hcl nebula.hcl
exec nebula-pki
! stderr 'generated CA "current"'
stderr '^generated CA "next" \(test-mesh-v2\)$'
! stderr 'signed cert'
stderr '^wrote trust bundle'
stderr '^wrote manifest'
! stdout .

exists out/ca/next.crt
exists out/ca/next.key

# Certs not re-signed: certs unchanged.
cmp out/certs/alpha.crt alpha.step1.crt
cmp out/certs/beta.crt  beta.step1.crt

# Bundle now contains both CAs (not equal to either CA cert alone).
! cmp out/bundles/main.crt out/ca/current.crt
! cmp out/bundles/main.crt out/ca/next.crt
grep 'NEBULA CERTIFICATE' out/bundles/main.crt

# Manifest records both CAs and both fingerprints in trust bundle.
grep '"current"' out/nebula-pki.json
grep '"next"' out/nebula-pki.json
grep '"test-mesh-v2"' out/nebula-pki.json
grep '"ca_fingerprints"' out/nebula-pki.json

# Snapshot two-CA bundle for step 3.
cp out/bundles/main.crt bundle.step2.crt

# ── Step 3: promote "next" to default — certs re-sign ────────────────────────
cp step3.hcl nebula.hcl
exec nebula-pki
! stderr 'generated CA'
stderr '^signed cert "alpha"$'
stderr '^signed cert "beta"$'
! stderr 'wrote trust bundle'
stderr '^wrote manifest'
! stdout .

# Certs re-signed under "next" CA.
! cmp out/certs/alpha.crt alpha.step1.crt
! cmp out/certs/beta.crt  beta.step1.crt

# Bundle unchanged: ca_refs did not change.
cmp out/bundles/main.crt bundle.step2.crt

# Snapshot new certs.
cp out/certs/alpha.crt alpha.step3.crt
cp out/certs/beta.crt  beta.step3.crt

# Idempotency: a second run with step 3 config is a noop.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'generated CA'
! stderr 'signed cert'
! stdout .

cmp out/certs/alpha.crt alpha.step3.crt
cmp out/certs/beta.crt  beta.step3.crt
cmp out/bundles/main.crt   bundle.step2.crt

# ── Step 4: drop "current" from ca_refs — bundle shrinks to "next" only ──────
cp step4.hcl nebula.hcl

# Dry-run must preview the bundle write even though no CA is generated
# and all certs are already signed.
exec nebula-pki --dry-run
stdout '^\+ write out/bundles/main\.crt$'
stdout '^\+ write out/nebula-pki\.json$'
stderr 'next deadline'
! stderr 'generated CA'
! stderr 'signed cert'

exec nebula-pki
! stderr 'generated CA'
! stderr 'signed cert'
stderr '^wrote trust bundle'
stderr '^wrote manifest'
! stdout .

# Certs not re-signed (already under "next", outside renewal window).
cmp out/certs/alpha.crt alpha.step3.crt
cmp out/certs/beta.crt  beta.step3.crt

# Bundle now equals just the "next" CA cert.
cmp out/bundles/main.crt out/ca/next.crt

# The dropped CA keeps its manifest record; there is no archived flag.
grep '"test-mesh"' out/nebula-pki.json
! grep '"archived"' out/nebula-pki.json

# Idempotency: a second run with the step 4 config is a noop.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'generated CA'
! stderr 'signed cert'
! stderr 'wrote trust bundle'
! stdout .

cmp out/certs/alpha.crt alpha.step3.crt
cmp out/certs/beta.crt  beta.step3.crt

# Dry-run after idempotency must also show nothing to do.
exec nebula-pki --dry-run
stdout '^up to date; nothing to do$'
! stderr 'wrote trust bundle'

# ── Step 5: delete the "current" block ───────────────────────────────────────
# "next" is up to date, certs are still signed under it, and the bundle is
# unchanged. The old CA cert/key files stay on disk with a notice, and the
# manifest drops the "current" record.
cp step5.hcl nebula.hcl
exec nebula-pki
! stderr 'generated CA'
! stderr 'signed cert'
! stderr 'wrote trust bundle'
stderr '^notice: ca "current" was removed from the config; its files stay on disk and are no longer managed:$'
stderr '^  out/ca/current\.crt$'
stderr '^  out/ca/current\.key$'
stderr '^wrote manifest'
! stdout .
exists out/ca/current.crt
exists out/ca/current.key

# Certs and bundle are byte-identical to end of step 4.
cmp out/certs/alpha.crt alpha.step3.crt
cmp out/certs/beta.crt  beta.step3.crt
cmp out/bundles/main.crt   out/ca/next.crt

! grep '"test-mesh"' out/nebula-pki.json
grep '"next"' out/nebula-pki.json

# The next run is a no-op and the notice is not repeated.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'notice'

-- step1.hcl --
trust_bundle "main" {
  ca_refs = [ca.current]
}

ca "current" {
  name    = "test-mesh"
  default = true
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}

cert "beta" {
  networks = ["10.0.0.2/16"]
}

-- step2.hcl --
trust_bundle "main" {
  ca_refs = [ca.current, ca.next]
}

ca "current" {
  name    = "test-mesh"
  default = true
}

ca "next" {
  name = "test-mesh-v2"
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}

cert "beta" {
  networks = ["10.0.0.2/16"]
}

-- step3.hcl --
trust_bundle "main" {
  ca_refs = [ca.current, ca.next]
}

ca "current" {
  name = "test-mesh"
}

ca "next" {
  name    = "test-mesh-v2"
  default = true
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}

cert "beta" {
  networks = ["10.0.0.2/16"]
}

-- step4.hcl --
trust_bundle "main" {
  ca_refs = [ca.next]
}

ca "current" {
  name = "test-mesh"
}

ca "next" {
  name    = "test-mesh-v2"
  default = true
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}

cert "beta" {
  networks = ["10.0.0.2/16"]
}

-- step5.hcl --
trust_bundle "main" {
  ca_refs = [ca.next]
}

ca "next" {
  name    = "test-mesh-v2"
  default = true
}

cert "alpha" {
  networks = ["10.0.0.1/16"]
}

cert "beta" {
  networks = ["10.0.0.2/16"]
}
