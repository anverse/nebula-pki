# trust_bundle.link_crt fans the bundle out with relative symlinks named after
# the bundle file, main.crt for trust_bundle "main" (ADR-026 §4). A CA symlink and the bundle symlink may share a
# directory when their file names differ. Re-runs are no-ops, and a directory
# removed from link_crt has its symlink deleted.

[!exec:readlink] skip 'readlink not in PATH'

cp v1.hcl nebula.hcl
exec nebula-pki
stderr '^wrote trust bundle "main": out/bundles/main\.crt$'
stderr '^linked trust bundle "main"$'
stderr '^  out/hetzner/main\.crt$'
stderr '^  out/aws/main\.crt$'
stderr '^linked CA "current"$'
stderr '^  out/hetzner/current\.crt$'
! stdout .

exec readlink out/hetzner/main.crt
stdout '^\.\./bundles/main\.crt$'
cmp out/hetzner/main.crt out/bundles/main.crt
cmp out/aws/main.crt out/bundles/main.crt
cmp out/hetzner/current.crt out/ca/current.crt

# The manifest records the bundle links under trust_bundles, the CA link under
# the CA.
grep '"path": "out/hetzner/main.crt"' out/nebula-pki.json
grep '"target": "../bundles/main.crt"' out/nebula-pki.json
grep '"path": "out/hetzner/current.crt"' out/nebula-pki.json

# Second run: all up to date.
exec nebula-pki
stderr '^up to date; nothing to do$'
! stderr 'linked'
! stdout .

# Removing a directory from the bundle's link_crt deletes only that symlink.
cp v2.hcl nebula.hcl
exec nebula-pki --dry-run
stdout '^\+ delete stale link out/aws/main\.crt$'
exec nebula-pki
stderr '^deleted link out/aws/main\.crt$'
! stderr 'wrote trust bundle'
! exists out/aws/main.crt
exists out/hetzner/main.crt
exists out/hetzner/current.crt
! grep 'out/aws/main.crt' out/nebula-pki.json

# A wrong symlink target is repaired.
rm out/hetzner/main.crt
symlink out/hetzner/main.crt -> ../ca/current.crt
exec nebula-pki
stderr '^linked trust bundle "main"$'
exec readlink out/hetzner/main.crt
stdout '^\.\./bundles/main\.crt$'

# A regular file at a bundle link path is never clobbered.
rm out/hetzner/main.crt
cp out/bundles/main.crt out/hetzner/main.crt
! exec nebula-pki
stderr 'out/hetzner/main\.crt is not a symlink; remove it manually'

-- v1.hcl --
trust_bundle "main" {
  ca_refs  = [ca.current]
  link_crt = ["out/hetzner", "out/aws"]
}

ca "current" {
  name     = "mesh-2026"
  link_crt = ["out/hetzner"]
}

-- v2.hcl --
trust_bundle "main" {
  ca_refs  = [ca.current]
  link_crt = ["out/hetzner"]
}

ca "current" {
  name     = "mesh-2026"
  link_crt = ["out/hetzner"]
}
